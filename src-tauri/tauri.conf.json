{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "orviz",
  "version": "0.1.0",
  "identifier": "net.babernathy.orviz",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -- --port 5173 --strictPort",
      "cwd": "../web",
      "wait": false
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../web"
    },
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "orviz",
        "width": 1600,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Flight visualizer for hobby rocketry",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
