{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rocketviz",
  "version": "0.1.0",
  "identifier": "net.rocketviz",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -- --port 5173 --strictPort",
      "cwd": "../web",
      "wait": false
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../web"
    },
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "rocketviz",
        "width": 1600,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Flight visualizer for hobby rocketry",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../engines/openrocket/build/engine/": "engines/openrocket/",
      "../engines/openrocket/build/jre/": "jre/"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzOEFDOEExODI4N0U0MzkKUldRNTVJZUNvY2lLRTB1SHdIQVBXazRCR1o4dEZjOWF6TDdwYnVpMmFhVVdxU1ExSzRiU1lWNTQK",
      "endpoints": [
        "https://github.com/benabernathy/rocketviz/releases/latest/download/latest.json"
      ]
    }
  }
}
